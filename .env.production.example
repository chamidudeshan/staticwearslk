# ═══════════════════════════════════════════════════════════════
# Static Wears — Production Environment Variables
# Copy this file to .env on your VPS and fill in every value.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════

# ─── DOMAINS ────────────────────────────────────────────────────
SITE_URL=https://staticwears.lk
ADMIN_URL=https://admin.staticwears.lk
API_EXTERNAL_URL=https://api.staticwears.lk
ADDITIONAL_REDIRECT_URLS=

# ─── POSTGRES ────────────────────────────────────────────────────
# Generate a strong password: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-strong-password

# ─── SUPABASE JWT ────────────────────────────────────────────────
# Generate: openssl rand -base64 64
JWT_SECRET=change-me-super-long-jwt-secret-at-least-32-chars

# Generate ANON_KEY and SERVICE_ROLE_KEY using the helper script:
#   node scripts/generate-keys.js
# Or use: https://supabase.com/docs/guides/self-hosting#generate-api-keys
ANON_KEY=
SERVICE_ROLE_KEY=

# ─── SUPABASE REALTIME ───────────────────────────────────────────
# Generate: openssl rand -base64 64
SECRET_KEY_BASE=change-me-secret-key-base

# ─── SUPABASE DASHBOARD ──────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-dashboard-password

# ─── SMTP (for auth emails) ──────────────────────────────────────
# Use Resend, Mailgun, SendGrid, or any SMTP provider
SMTP_ADMIN_EMAIL=no-reply@staticwears.lk
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key
ENABLE_EMAIL_AUTOCONFIRM=false

# ─── STRIPE ──────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── RESEND (transactional emails) ───────────────────────────────
RESEND_API_KEY=re_...

# ─── PAYPAL ──────────────────────────────────────────────────────
# Create an app at https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to https://api-m.paypal.com for production
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Public client ID (exposed to browser)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# ─── PAYHERE ─────────────────────────────────────────────────────
# Register at https://www.payhere.lk/
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Set to "production" to use live gateway
PAYHERE_ENV=sandbox
NEXT_PUBLIC_PAYHERE_MERCHANT_ID=
